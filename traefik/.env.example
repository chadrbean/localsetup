# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# IAM user hermes-caddy-dns01 (route53 DNS-01 for chadrbean.com public zone;
# same keys as caddy/.env — that user name predates the Traefik switch).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# Pin lego to the PUBLIC zone (a private chadrbean.com zone also exists):
AWS_HOSTED_ZONE_ID=Z030496415CSA0E3T50AY
# Traefik dashboard basic auth (traefik.chadrbean.com). bcrypt hash of
# "user:password", generated with `htpasswd -nbB <user> '<password>'`.
# Keep the single $ as htpasswd prints it: env_file values are passed through
# literally, and doubling them to $$ breaks the hash (README "Dashboard").
#   HASH=$(htpasswd -nbB chad 'your-password-here')
TRAEFIK_DASHBOARD_AUTH=
# me.chadrbean.com landing page (homepage/) basic auth. Separate credentials
# from TRAEFIK_DASHBOARD_AUTH above — same htpasswd -nbB recipe, single $.
ME_DASHBOARD_AUTH=
# otbla-local.chadrbean.com (Decap CMS + Hugo dev server) basic auth. Same
# recipe, single $. Use a long random password. The fail2ban middleware bans a
# client IP after repeated 401s, but LAN and loopback are allowlisted.
OTBLA_LOCAL_AUTH=
