# Compose — localsetup (podman-native)
#
# Manage the compose stacks (litellm/, traefik/) with the repo wrapper:
#   ./compose.sh <litellm|traefik> <args>
# which runs podman-compose (this box's compose engine — no docker installed;
# `docker` was podman-docker's shim) in the project dir with .env loaded.
#
# The stacks run as PODS ([REDACTED] 1.2.0 creates one pod per stack on
# `up -d`, e.g. pod_litellm with pod-style container names litellm_db,
# litellm_litellm_1). A `down` + `up -d` migrates a podless stack into a
# pod; named volumes survive the rebuild.
#   - `./compose.sh <p> ps` shows nothing for a running stack (1.2.0 quirk) —
#     use `podman ps` / `podman pod ps` for status.

alias dc='podman-compose'

# Grafana admin (monitoring stack — grafana.chadrbean.com:8443)
# Generate: openssl rand -hex 24  (keep out of git — .env is ignored)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
