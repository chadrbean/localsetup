# Compose — localsetup (podman-native)
#
# Manage the compose stacks (litellm/, traefik/) with the repo wrapper:
#   ./compose.sh <litellm|traefik> <args>
# which runs podman-compose (this box's compose engine — no docker installed;
# `docker` was podman-docker's shim) in the project dir with .env loaded.
#
# The stacks run podless (plain `podman run` containers, docker-compose-v2
# style). podman-compose 1.2.0 creates a pod when it builds a stack, so:
#   - `./compose.sh <p> up -d`  recreates the project as a POD (use it for a
#     from-scratch bring-up and accept pod-style naming),
#   - `./compose.sh <p> ps` shows nothing for a podless stack (known quirk) —
#     use `podman ps` for status instead.

alias dc='podman-compose'
