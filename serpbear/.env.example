# SerpBear secrets — copy to .env (git-ignored) and fill in. Never commit .env.
#
# Login for the web UI
USER=
PASSWORD=
# Random strings: openssl rand -hex 32
SECRET=
APIKEY=
# Session length in hours
SESSION_DURATION=24
#
# Host directory for persistent data (SQLite DB, settings). Default shown.
# SERPBEAR_DATA_DIR=/home/chad/.local/share/serpbear
#
# Google Search Console (service account). Private key on ONE line, newlines as literal \n.
SEARCH_CONSOLE_CLIENT_EMAIL=
SEARCH_CONSOLE_PRIVATE_KEY=
