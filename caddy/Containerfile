# Custom Caddy build with the Route53 DNS plugin, so Caddy can get/renew
# publicly-trusted certs via DNS-01 (no port 80 / port forwarding needed).
# Pure Go build via xcaddy — no pip, no host-level package installs.
FROM caddy:2-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/route53

FROM caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
