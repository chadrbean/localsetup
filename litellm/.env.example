# llmlocalsetup gateway env — THE single source of truth for
# upstream model-provider keys. Hermes never holds these.
# Bind-mounted into the litellm container at /app/.env; also auto-loaded by
# podman-compose for ${VAR} substitution in docker-compose.yml (redis).
#
#   LITELLM_MASTER_KEY      admin key (create_keys.sh, UI, spend)
#   DEEPSEEK_API_KEY        upstream DeepSeek (flash/pro tiers)
#   OPENROUTER_API_KEY      upstream OpenRouter (kimi/gpt5/glm/minimax)
#   LITELLM_DB_PASSWORD     postgres (spend logs)
#   LITELLM_GENERAL_KEY / LITELLM_OPENROUTER_KEY / LITELLM_AUTOMATION_KEY
#                           virtual keys minted by create_keys.sh — leave
#                           blank here, create_keys.sh appends them;
#                           LITELLM_GENERAL_KEY + LITELLM_OPENROUTER_KEY
#                           are duplicated into ~/.hermes/.env for Hermes.
DEEPSEEK_API_KEY=
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=
LITELLM_DB_PASSWORD=
LITELLM_OPENROUTER_KEY=
LITELLM_GENERAL_KEY=
LITELLM_AUTOMATION_KEY=
LITELLM_SALT_KEY=
STORE_MODEL_IN_DB='True'
ZAI_API_KEY=
REDIS_PASSWORD=
