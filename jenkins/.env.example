# Jenkins secrets — copy to .env (git-ignored) and fill in. Never commit .env.
#
# JCasC layers to load (comma-separated). Start with base only; add /casc/github
# once the GitHub App exists and ~/.local/share/jenkins/secrets/github-app.pem is in place.
CASC_PATHS=/casc/base
# CASC_PATHS=/casc/base,/casc/github
#
# Local admin (the only Jenkins user). openssl rand -base64 24
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
#
# Failure / cert-expiry notifications
ALERT_EMAIL_TO=crb4u@yahoo.com
#
# SES SMTP — same values as monitoring/.env GRAFANA_SMTP_USER / GRAFANA_SMTP_PASSWORD
# (Terraform-managed IAM user hermes-ses-email; sender hermes@chadrbean.com).
SES_SMTP_USER=
SES_SMTP_PASSWORD=
#
# GitHub App "chadrbean-jenkins" (github layer)
GITHUB_APP_ID=
# openssl rand -hex 32 — paste the same value into the App's webhook secret
GITHUB_WEBHOOK_SECRET=
#
# IAM Roles Anywhere (aws-infrastructure outputs trust_anchor_arn / jenkins_profile_arn)
RA_TRUST_ANCHOR_ARN=
RA_PROFILE_ARN=
