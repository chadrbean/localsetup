# ci-hugo — build image for blogLosAngeles pipelines (deploy, security-gate,
# smoketests, seo). Replaces peaceiris/actions-hugo, setup-go, setup-python and the
# curl/pip tool installs in security-gate.yml. Versions MUST match
# blogLosAngeles/.security/tool-versions.env (security-gate asserts this at runtime).
#   podman build -t localhost/ci-hugo:1 jenkins/images/ci-hugo
FROM docker.io/library/python:3.12-slim-trixie

ARG HUGO_VERSION=0.160.0
ARG GO_VERSION=1.26.1
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG OSV_SCANNER_VERSION=2.6.0
ARG OSV_SCANNER_SHA256=ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108
ARG CHECKOV_VERSION=3.3.19
ARG ZIZMOR_VERSION=1.30.1
ARG GH_VERSION=2.101.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl unzip git jq ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/dl
# Hugo extended (checksum file from the release)
RUN curl -fsSLO "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-amd64.tar.gz" \
 && curl -fsSLO "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_${HUGO_VERSION}_checksums.txt" \
 && grep " hugo_extended_${HUGO_VERSION}_linux-amd64.tar.gz$" "hugo_${HUGO_VERSION}_checksums.txt" | sha256sum -c - \
 && tar -xzf "hugo_extended_${HUGO_VERSION}_linux-amd64.tar.gz" -C /usr/local/bin hugo
# Go (Hugo modules)
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o go.tgz \
 && curl -fsSL "https://go.dev/dl/?mode=json&include=all" | jq -r --arg f "go${GO_VERSION}.linux-amd64.tar.gz" '.[].files[] | select(.filename==$f) | .sha256 + "  go.tgz"' | sha256sum -c - \
 && tar -xzf go.tgz -C /usr/local
# gitleaks + osv-scanner, pinned sha256 (same values as tool-versions.env)
RUN curl -fsSLO "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
 && echo "${GITLEAKS_SHA256}  gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" | sha256sum -c - \
 && tar -xzf "gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" -C /usr/local/bin gitleaks \
 && curl -fsSL -o /usr/local/bin/osv-scanner "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64" \
 && echo "${OSV_SCANNER_SHA256}  /usr/local/bin/osv-scanner" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/osv-scanner
# gh + awscli (bot pushes, S3 sync, CloudFront invalidation)
RUN curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" | tar -xz \
 && mv "gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
 && curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o awscli.zip \
 && unzip -q awscli.zip && ./aws/install \
 && cd / && rm -rf /tmp/dl

RUN pip install --no-cache-dir "checkov==${CHECKOV_VERSION}" "zizmor==${ZIZMOR_VERSION}" pyyaml

ENV PATH=/usr/local/go/bin:$PATH \
    GOPATH=/root/go
WORKDIR /
# Record pins inside the image so pipelines can assert them against tool-versions.env
RUN printf 'HUGO_VERSION=%s\nGO_VERSION=%s\nGITLEAKS_VERSION=%s\nOSV_SCANNER_VERSION=%s\nCHECKOV_VERSION=%s\nZIZMOR_VERSION=%s\n' \
      "$HUGO_VERSION" "$GO_VERSION" "$GITLEAKS_VERSION" "$OSV_SCANNER_VERSION" "$CHECKOV_VERSION" "$ZIZMOR_VERSION" > /etc/ci-tool-versions \
 && hugo version && go version && gitleaks version && osv-scanner --version && checkov --version && zizmor --version
