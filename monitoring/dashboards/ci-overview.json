    {
      "id": 2,
      "type": "stat",
      "title": "Per-change pipelines \u2014 latest main result",
      "description": "The pipeline each change goes through, one per project. Red = a BLOCKING check failed (the category comes from that repo's ci/checks.yml; rules in its docs/ci-gates.md). Yellow = advisory findings only. zca-accounting/ci is manual-only (Constitution Principle XX), so its result can be days old. Alert: ci_main_failing.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "default_jenkins_builds_last_build_result_ordinal{jenkins_job=~\"(aws-infrastructure/terraform|localsetup/ci|zca-accounting/ci|blogLosAngeles/delivery)/main\"}",
          "legendFormat": "{{jenkins_job}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SUCCESS",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "WARN (unstable)",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "FAILED",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "not built",
                  "color": "#8e8e8e",
                  "index": 3
                },
                "4": {
                  "text": "aborted",
                  "color": "#8e8e8e",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
