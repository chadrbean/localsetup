          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Top 404 paths (time range)",
      "description": "Most-probed paths that don't exist \u2014 vulnerability scanners (/.env, /wp-login.php, ...).",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(15, sum by (RequestPath) (count_over_time({job=\"traefik\", status=\"404\"} | json RequestPath=\"RequestPath\" [$__range])))",
          "editorMode": "code",
          "legendFormat": "{{RequestPath}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "orange"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Top request hosts on 4xx (time range)",
      "description": "Host headers of rejected requests. Raw IPs / foreign hostnames = scanners hitting the box directly.",
