      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (router) (count_over_time({job=\"traefik\", status=\"404\"} [$__auto]))",
          "editorMode": "code",
          "legendFormat": "{{router}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
