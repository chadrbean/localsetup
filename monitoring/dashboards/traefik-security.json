    {
      "id": 14,
      "type": "timeseries",
      "title": "Grafana login failures",
      "description": "POST /api/login answered 401 via Traefik. 5 in 10m from one IP triggers a fail2ban grafana ban.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({job=\"traefik\", router=\"grafana@file\", status=\"401\"} | json RequestPath=\"RequestPath\" | RequestPath=\"/api/login\" [$__auto]))",
          "editorMode": "code",
          "legendFormat": "failed logins",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
