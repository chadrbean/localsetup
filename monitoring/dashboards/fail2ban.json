        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A",
          "expr": "sum(f2b_jail_banned_current{jail=~\"$jail\"})",
          "editorMode": "code",
          "instant": false,
          "range": true
