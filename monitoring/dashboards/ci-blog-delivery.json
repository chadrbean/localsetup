    {
      "id": 11,
      "type": "timeseries",
      "title": "Pass rate (30d) per job on main",
      "description": "success / (success + unstable + failed) over the last 30 days, per blogLosAngeles job on main. Skipped (NOT_BUILT) runs are excluded. Target (spec 001 SC-001): delivery >= 90%.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "legendFormat": "{{repo}}",
          "expr": "(increase(default_jenkins_builds_success_build_count_total{jenkins_job=~\"blogLosAngeles/.*/main\"}[30d])) / ((increase(default_jenkins_builds_success_build_count_total{jenkins_job=~\"blogLosAngeles/.*/main\"}[30d])) + ((increase(default_jenkins_builds_unstable_build_count_total{jenkins_job=~\"blogLosAngeles/.*/main\"}[30d])) or (increase(default_jenkins_builds_success_build_count_total{jenkins_job=~\"blogLosAngeles/.*/main\"}[30d])) * 0) + ((increase(default_jenkins_builds_failed_build_count_total{jenkins_job=~\"blogLosAngeles/.*/main\"}[30d])) or (increase(default_jenkins_builds_success_build_count_total{jenkins_job=~\"blogLosAngeles/.*/main\"}[30d])) * 0))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
