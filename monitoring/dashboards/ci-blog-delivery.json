        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "delivery/main \u2014 stages of the latest run",
      "description": "Each stage of the most recent blogLosAngeles/delivery run on main: Prepare \u2192 Maintain content \u2192 Build \u2192 Checks (tests/security/seo) \u2192 Infrastructure \u2192 Deploy \u2192 Verify. FAILED names the stage that blocked; open the run in Jenkins for the 'Blocked by <id>' badge and the per-check table. 'skipped' is normal for stages that don't apply (e.g. Infrastructure without terraform changes).",
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "default_jenkins_builds_last_stage_result_ordinal{jenkins_job=\"blogLosAngeles/delivery/main\", stage!~\"Declarative: .*\"}",
          "legendFormat": "{{stage}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "skipped",
                  "color": "#8e8e8e",
                  "index": 0
                },
                "1": {
                  "text": "aborted",
                  "color": "#8e8e8e",
                  "index": 1
                },
                "2": {
                  "text": "passed",
                  "color": "green",
                  "index": 2
                },
                "3": {
                  "text": "running",
                  "color": "blue",
                  "index": 3
                },
                "4": {
                  "text": "waiting (input)",
                  "color": "yellow",
                  "index": 4
                },
                "5": {
                  "text": "FAILED",
                  "color": "red",
                  "index": 5
                },
                "6": {
                  "text": "WARN",
                  "color": "yellow",
                  "index": 6
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          },
          "links": [
