# Copy to ~/.config/aws-signing-helper/grafana.env (chmod 600). No secrets: these are ARNs.
# From aws-infrastructure outputs (terraform output -raw <name>) or `aws rolesanywhere list-profiles`.
TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-west-2:188627879503:trust-anchor/c033f6b6-e34b-43bb-a7bc-1bd5c33af079
# ci_rolesanywhere_grafana_profile_arn
PROFILE_ARN=arn:aws:rolesanywhere:us-west-2:188627879503:profile/REPLACE_WITH_HOST_GRAFANA_PROFILE_ID
# ci_rolesanywhere_grafana_role_arn
ROLE_ARN=arn:aws:iam::188627879503:role/grafana-cloudwatch-read
