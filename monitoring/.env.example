# Grafana admin credentials for the monitoring stack. Auto-loaded by
# podman-compose for ${GRAFANA_ADMIN_PASSWORD} substitution in
# docker-compose.yml. Generate a new password with: openssl rand -hex 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Alert email delivery — Amazon SES SMTP (us-west-1, chadrbean.com DKIM-verified).
# SMTP credentials are NOT the AWS access key: create an IAM user with
# ses:SendRawEmail and derive the SMTP password (see monitoring/README.md
# "Alert email (SES SMTP)"). SES is in sandbox, so ALERT_EMAIL_TO must be a
# verified identity in us-west-1.
GRAFANA_SMTP_HOST=email-smtp.us-west-1.amazonaws.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=grafana@chadrbean.com
ALERT_EMAIL_TO=
