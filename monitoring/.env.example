# Grafana admin credentials for the monitoring stack. Auto-loaded by
# podman-compose for ${GRAFANA_ADMIN_PASSWORD} substitution in
# docker-compose.yml. Generate a new password with: openssl rand -hex 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Alert notifications (Grafana -> Amazon SES SMTP, us-west-1). SMTP creds belong
# to the send-only IAM user `grafana-ses-smtp` (see monitoring/README.md,
# "Alert email"); the password is DERIVED from its secret access key, not the
# key itself. GRAFANA_ALERT_EMAIL must be an SES-verified identity while the
# account is in the SES sandbox.
GRAFANA_SMTP_ENABLED=true
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_ALERT_EMAIL=
