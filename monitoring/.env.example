# Grafana admin credentials for the monitoring stack. Auto-loaded by
# podman-compose for ${GRAFANA_ADMIN_PASSWORD} substitution in
# docker-compose.yml. Generate a new password with: openssl rand -hex 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Alert email delivery — Amazon SES SMTP in us-west-2.
# Credentials come from the Terraform-managed hermes-ses-email IAM user in
# ~/git/aws-infrastructure (see monitoring/README.md "Alert email (SES SMTP)"):
#   GRAFANA_SMTP_USER     = terraform output -raw hermes_ses_email_access_key_id
#   GRAFANA_SMTP_PASSWORD = terraform output -raw hermes_ses_email_smtp_password
# That user's IAM policy only permits ses:FromAddress = hermes@chadrbean.com —
# a different GRAFANA_SMTP_FROM is rejected. SES is in sandbox: ALERT_EMAIL_TO
# must be a verified identity in us-west-2.
GRAFANA_SMTP_HOST=email-smtp.us-west-2.amazonaws.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=hermes@chadrbean.com
ALERT_EMAIL_TO=
