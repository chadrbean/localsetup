{
  "title": "Website Performance — otbla.com",
  "uid": "site-perf-otbla",
  "description": "Uptime, HTTP response time, and TLS certificate health for www.otbla.com (032-site-perf-dashboard). Powered by Prometheus Blackbox Exporter probing every 60s.",
  "tags": ["site", "uptime", "tls", "blackbox"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Site Health",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current Status",
      "description": "1 = UP, 0 = DOWN. Last probe result.",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          },
          "unit": "short",
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "probe_success{instance=\"https://otbla.com/\", job=\"blackbox\"}",
          "instant": true,
          "legendFormat": "Status"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime (7d)",
      "description": "Percentage of probes returning probe_success=1 over the last 7 days.",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.99 }, { "color": "green", "value": 0.999 }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "avg_over_time(probe_success{instance=\"https://otbla.com/\", job=\"blackbox\"}[7d])",
          "instant": true,
          "legendFormat": "Uptime"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "TLS Certificate Expiry",
      "description": "Days until the TLS certificate expires. Alert fires at <14 days. Current cert expires 2027-03-21.",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 14 }, { "color": "green", "value": 30 }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "(probe_ssl_earliest_cert_expiry{instance=\"https://otbla.com/\", job=\"blackbox\"} - time()) / 86400",
          "instant": true,
          "legendFormat": "Days remaining"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Last Response Time",
      "description": "Most recent HTTP probe duration in milliseconds.",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "probe_duration_seconds{instance=\"https://otbla.com/\", job=\"blackbox\"} * 1000",
          "instant": true,
          "legendFormat": "Response ms"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Response Time",
      "description": "Total probe duration and phase breakdown (DNS, connect, TLS, transfer). Probed every 60s.",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "probe_duration_seconds{instance=\"https://otbla.com/\", job=\"blackbox\"} * 1000",
          "legendFormat": "Total"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "probe_dns_lookup_time_seconds{instance=\"https://otbla.com/\", job=\"blackbox\"} * 1000",
          "legendFormat": "DNS"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "probe_http_duration_seconds{phase=\"connect\", instance=\"https://otbla.com/\", job=\"blackbox\"} * 1000",
          "legendFormat": "Connect"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "probe_http_duration_seconds{phase=\"tls\", instance=\"https://otbla.com/\", job=\"blackbox\"} * 1000",
          "legendFormat": "TLS"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "probe_http_duration_seconds{phase=\"transfer\", instance=\"https://otbla.com/\", job=\"blackbox\"} * 1000",
          "legendFormat": "Transfer"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Uptime (probe_success over time)",
      "description": "1 = probe succeeded (200 + body match). 0 = failed. Gaps = blackbox exporter or Prometheus down.",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          },
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "probe_success{instance=\"https://otbla.com/\", job=\"blackbox\"}",
          "legendFormat": "probe_success"
        }
      ]
    }
  ]
}
