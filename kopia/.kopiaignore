# Kopia ignore rules for the home dir (gitignore syntax). SHARED by both desktops:
#   wkspikaoschad   (/home/chad)   ~/.kopiaignore is a HARDLINK to this file. After a
#                                  git pull/checkout replaces it: ln -f kopia/.kopiaignore ~/.kopiaignore
#   wkspikaoszuriel (/home/zuriel) plain copy: scp kopia/.kopiaignore zuriel:.kopiaignore
# Rules for paths a host doesn't have are harmless no-ops, so keep ONE file.
#
# How the rules work:
#   /foo/   anchored to /home/chad; trailing / = directories only
#   foo/    no leading / = matches at any depth
#   !foo    re-include; the LAST matching rule wins
# Kopia never enters an excluded directory, so a `!` rule can't reach inside one.
# To keep one child of a big dir: exclude the dir's CHILDREN (/dir/*), then
# re-include the child (!/dir/keep/). See the .local and .claude sections below.
# Check the effect with:  kopia snapshot estimate /home/chad

# ---------------------------------------------------------------------------
# OS, mounts, system: not ours or not files
# ---------------------------------------------------------------------------
/mnt/
/usr/
/opt/
/gvfs/
/snap/
/libvirt/
/.Public/
/Desktop/
/Downloads/
# rclone FUSE mounts of S3 buckets (already in S3)
/Documents/awsS3*/
/.bash_history
/.face*

# ---------------------------------------------------------------------------
# Caches & toolchains: re-downloadable
# ---------------------------------------------------------------------------
/.cache/
/.npm/
/.bun/
/.nvm/
/.npm-global/
/.cargo/
/.rustup/
/.sdkman/
/.dotnet/
/.mono/
/.java/
/.eclipse/
/go/
/.EasyOCR/
/.terraform.d/
/.config/Code/Cache/
/.config/Code/CachedData/
/.config/Code/CachedExtensionVSIXs/
/.config/Code/WebStorage/
/.config/Code/logs/

# ---------------------------------------------------------------------------
# Build artifacts, at any depth: regenerated by installs/builds
# ---------------------------------------------------------------------------
node_modules/
.terraform/
.venv/
venv/
__pycache__/
.dist-build-*/
# Claude Code worktrees: commits live in the main repo's .git
/git/*/.claude/worktrees/

# ---------------------------------------------------------------------------
# Browsers & desktop apps: profiles/caches, re-creatable
# ---------------------------------------------------------------------------
/.config/chromium/
/.config/BraveSoftware/
/.config/joplin-desktop/
/.config/Claude/
/.joplin*
/.vscode/
/.vscode-shared/
/.thinkorswim/
/thinkorswim/
/.seospyglass/
/.websiteauditor/
/.SoulseekQt/
/Soulseek Chat Logs/
# audio plugins / DAW add-ons
/.vst3/
/.lv2/
/.hydrogen/

# ---------------------------------------------------------------------------
# AI tool state: sessions/caches, not config
# ---------------------------------------------------------------------------
/.codex/
/.copilot/
/.cua*/
/.opencode/
/.claude-server-commander/
/.pdf-toolkit-files/

# ---------------------------------------------------------------------------
# Media & installers: large, stored elsewhere or re-downloadable
# ---------------------------------------------------------------------------
/Videos/
# Screen recordings (GNOME "Screencast From <date>.mp4"), wherever they're saved;
# excluded by choice on both hosts (2026-09-26: ~43 GB on Zuriel's)
/Screencasts/
/Documents/Zuriel/Screencasts/
Screencast From *
/AppImage/
/APPZ/
/ISOZ/

# ---------------------------------------------------------------------------
# Games: the launcher re-downloads these. KEPT: saves/ (Zuriel's son's worlds),
# flashback/ (replay recordings), backups/, mods/, resourcepacks/, screenshots/, options
# ---------------------------------------------------------------------------
/.minecraft/assets/
/.minecraft/versions/
/.minecraft/libraries/
/.minecraft/runtime/
/.minecraft/launcher/
/.minecraft-*.tgz

# ---------------------------------------------------------------------------
# Hermes: back up state (config, auth, *.db, sessions, skills, memories,
# cron, hooks, kanban), not the reinstallable agent install or its caches
# ---------------------------------------------------------------------------
/.hermes/hermes-agent/
/.hermes/tools/
/.hermes/bin/
/.hermes/cache/
/.hermes/lsp/
/.hermes/installs/
/.hermes/audio_cache/
/.hermes/image_cache/
/.hermes/logs/
/.hermes/*.bak*

# ---------------------------------------------------------------------------
# ~/.var (Flatpak app data): skip everything except the user folders inside
# Wine "bottles" (Bottles flatpak). Zuriel's Mine-imator animation projects live in
# bottles/Mineimator/drive_c/users/steamuser/Mine-imator/Projects; the Moho bottle
# is covered the same way.
# ---------------------------------------------------------------------------
/.var/*
!/.var/app/
/.var/app/*
!/.var/app/com.usebottles.bottles/
/.var/app/com.usebottles.bottles/*
!/.var/app/com.usebottles.bottles/data/
/.var/app/com.usebottles.bottles/data/*
!/.var/app/com.usebottles.bottles/data/bottles/
/.var/app/com.usebottles.bottles/data/bottles/*
!/.var/app/com.usebottles.bottles/data/bottles/bottles/
/.var/app/com.usebottles.bottles/data/bottles/bottles/*/*
!/.var/app/com.usebottles.bottles/data/bottles/bottles/*/drive_c/
/.var/app/com.usebottles.bottles/data/bottles/bottles/*/drive_c/*
!/.var/app/com.usebottles.bottles/data/bottles/bottles/*/drive_c/users/
/.var/app/com.usebottles.bottles/data/bottles/bottles/*/drive_c/users/*/Temp/

# ---------------------------------------------------------------------------
# ~/.local: skip everything except app data and infra secrets
# ---------------------------------------------------------------------------
/.local/*
!/.local/share/
/.local/share/*
!/.local/share/serpbear/
!/.local/share/librecrawl/
!/.local/share/homepage/
# Roles Anywhere host cert/key
!/.local/share/aws-roles-anywhere/
# Jenkins: only the Roles Anywhere CA and Jenkins secrets (config is JCasC in git;
# data/jobs is 48 GB of build history)
!/.local/share/jenkins/
/.local/share/jenkins/*
!/.local/share/jenkins/ca/
!/.local/share/jenkins/secrets/

# ---------------------------------------------------------------------------
# ~/.claude: keep config, skills, docs and memory; skip transcripts, jobs, caches
# ---------------------------------------------------------------------------
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.json
!/.claude/statusline-command.sh
!/.claude/email.conf
!/.claude/skills/
!/.claude/docs/
!/.claude/bin/
!/.claude/agents/
!/.claude/agent-memory/
!/.claude/plans/
!/.claude/projects/
/.claude/projects/*/*
!/.claude/projects/*/memory/
