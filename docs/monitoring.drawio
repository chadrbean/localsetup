        <!-- collectors -->
        <mxCell id="promtail" value="Promtail (native user svc)&lt;br&gt;:9190&lt;br&gt;labels + structured metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1360" y="470" width="180" height="80" as="geometry" />
