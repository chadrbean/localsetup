        <mxCell id="kopialog" value="~/.cache/kopia/cli-logs&lt;br&gt;(snapshot summaries)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="860" y="560" width="160" height="60" as="geometry" />
