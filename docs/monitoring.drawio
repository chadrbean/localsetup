<mxfile host="drawio" version="24.7.0">
  <diagram id="monitoring" name="Monitoring &amp; fail2ban">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- host boundary -->
        <mxCell id="host" value="Host wkspikaoschad (native services + rootless podman, host network)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1730" height="760" as="geometry" />
        </mxCell>

        <!-- internet -->
        <mxCell id="inet" value="Internet&lt;br&gt;(users + attackers)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_alt2;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- edge -->
        <mxCell id="nft" value="nftables&lt;br&gt;inet f2b-table&lt;br&gt;(ban sets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="240" y="240" width="120" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sslh" value="sslh :443&lt;br&gt;(SSH / TLS sniff)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="420" y="250" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sshd" value="sshd :22&lt;br&gt;(journald ssh.service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="traefik" value="Traefik (podman)&lt;br&gt;fail2ban HTTP plugin&lt;br&gt;metrics :8082" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="620" y="400" width="150" height="80" as="geometry" />
        </mxCell>

        <!-- fail2ban -->
        <mxCell id="f2b" value="fail2ban-server (root)&lt;br&gt;jails: sshd · grafana · recidive&lt;br&gt;progressive bans, db 30d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="220" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f2blog" value="/var/log/fail2ban.log&lt;br&gt;(Found / Ban / Unban)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="60" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="exporter" value="fail2ban_exporter (root)&lt;br&gt;127.0.0.1:9191&lt;br&gt;f2b_up · banned · failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1120" y="230" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="accesslog" value="traefik/logs/access.log&lt;br&gt;(JSON)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="860" y="410" width="160" height="60" as="geometry" />
